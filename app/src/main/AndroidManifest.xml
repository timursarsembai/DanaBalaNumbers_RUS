<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешения для сети (AdMob) и биллинга -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:name=".DanaBalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DanaBala">

        <!-- AdMob App ID. Для debug используем тестовый, для release — реальный (см. manifestPlaceholders) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <!-- Главная активность теперь MathExercisesActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MathExercisesActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PaywallActivity"
            android:exported="false"
            android:enabled="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <!-- Базовые активности -->
        <activity
            android:name=".NumberIntroductionActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NumberRecognitionActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CountingActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ObjectCountingActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MatchingActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AudioMatchingActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NumberDrawingActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AscendingSequenceActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DescendingSequenceActivity"
