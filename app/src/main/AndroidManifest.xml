            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NumberComparisonActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".LanguageSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".KidsComparisonActivity"
            android:exported="false"
            android:parentActivityName=".MathExercisesActivity"
            android:screenOrientation="landscape" />

        <!-- Страницы результатов -->
        <activity
